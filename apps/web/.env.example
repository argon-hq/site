# Server-side only: these variables never reach the browser (no NEXT_PUBLIC_ prefix).
# In AWS they come from Parameter Store, under /argon/<env>/.
API_URL=http://localhost:3001
INTERNAL_API_SECRET=change-me
# Public origin of the site, for the absolute URLs in metadata (Open Graph, sitemap, robots).
# In deploy the same env file feeds the API and the site, and it already carries WEB_ORIGIN
# for the links of the e-mails.
WEB_ORIGIN=https://localhost:3000
