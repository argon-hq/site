# Same names as the Parameter Store keys under /argon/<env>/
# In AWS the URL ends with ?sslmode=verify-full&sslrootcert=/etc/rds-ca.pem
DATABASE_URL=postgresql://argon:argon@localhost:5432/argon_dev
ANTHROPIC_API_KEY=
INTERNAL_API_SECRET=local-dev-secret-change-me

# change to production values in AWS
NODE_ENV=development
PORT=3001

# Absolute origins that go into the e-mail links: the site serves the unsubscribe page, the API
# the one-click endpoint (RFC 8058). In AWS, https://<env> and https://api.<env>.
#
# The site is https even locally: the edition validation only accepts https links, and a link the
# local site could not answer would be worse than no link. `pnpm certs` makes the certificate and
# `pnpm dev` serves it. The API stays http — it is reached only by the site and by curl on this
# machine, it never appears in the validated HTML, and putting it behind a private authority would
# only break the call the site makes (Next does not pass NODE_EXTRA_CA_CERTS to its own server).
WEB_ORIGIN=https://localhost:3000
API_ORIGIN=http://localhost:3001

# Mail. The default is the local Mailpit (pnpm db:up), which accepts everything and delivers
# nothing: http://localhost:8025. In AWS, MAIL_TRANSPORT=resend plus the key.
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=
