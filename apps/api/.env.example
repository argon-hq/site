# Same names as the Parameter Store keys under /argon/<env>/
# In AWS dev and lab point at the Postgres container on the instance, host `postgres`, with no TLS:
# the connection never leaves the Compose network. An environment still on RDS ends the URL with
# ?sslmode=verify-full&sslrootcert=/etc/rds-ca.pem
DATABASE_URL=postgresql://argon:argon@localhost:5432/argon_dev
ANTHROPIC_API_KEY=
INTERNAL_API_SECRET=local-dev-secret-change-me

# change to production values in AWS
NODE_ENV=development
PORT=3001

# The 5h30 generation, Monday to Saturday, America/Sao_Paulo. Off here and on in dev while the
# pipeline is being built; prod turns it on when the sending step lands. With it off, the run is
# still available by hand: POST /pipeline/run.
SCHEDULER_ENABLED=false

# Mastra Studio served by this API under /studio. On in dev and lab, off in prod. Locally
# `pnpm mastra:dev` is the usual way in; turn this on to reach the same Studio through the API, at
# http://localhost:3001/studio.
STUDIO_ENABLED=false

# Where this is: local | lab | dev | prod. It decides how much a run may cost — the model, how far
# the agent may search, and whether it runs at all or over the fixture (src/pipeline/profile.ts).
# The deploy writes it in AWS; here it is the cheapest profile, which collects and writes nothing
# from a model. `POST /pipeline/run {"mode":"live"}` pays for a real run when you need one.
ARGON_ENV=local

# Absolute origins that go into the e-mail links: the site serves the unsubscribe page, the API
# the one-click endpoint (RFC 8058). In AWS, https://<env> and https://api.<env>.
#
# The site is https even locally: the edition validation only accepts https links, and a link the
# local site could not answer would be worse than no link. `pnpm certs` makes the certificate and
# `pnpm dev` serves it. The API stays http — it is reached only by the site and by curl on this
# machine, it never appears in the validated HTML, and putting it behind a private authority would
# only break the call the site makes (Next does not pass NODE_EXTRA_CA_CERTS to its own server).
WEB_ORIGIN=https://localhost:3000
API_ORIGIN=http://localhost:3001

# Mail. The default is the local Mailpit (pnpm db:up), which accepts everything and delivers
# nothing: http://localhost:8025. In AWS, MAIL_TRANSPORT=resend plus the key.
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=
