// Application schema. Mastra keeps its own tables in the `mastra` schema, outside Prisma.
// Rules Prisma cannot express (check constraints, triggers, seed rows) live in the migration SQL.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum SubscriberStatus {
  pending
  confirmed
  cancelled
  bounced
  blocked

  @@map("subscriber_status")
}

enum ArticleCategory {
  business
  entrepreneurship
  technology
  economy
  politics

  @@map("article_category")
}

// Where an address lists news: an RSS or Atom feed, a news sitemap, or a web search restricted to
// the source's domain (only if a source ends up with neither of the other two).
enum FeedKind {
  feed
  news_sitemap
  search

  @@map("feed_kind")
}

// How much of the article the feed carried: the whole text, a lead, or nothing but the title.
enum TextKind {
  full
  summary
  none

  @@map("text_kind")
}

enum EditionStatus {
  generating
  ready
  sending
  sent
  failed
  skipped

  @@map("edition_status")
}

enum DeliveryStatus {
  pending
  sent
  delivered
  soft_bounce
  hard_bounce
  complaint
  failed

  @@map("delivery_status")
}

model Subscriber {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                  String           @unique // lower-case, trimmed (check constraint)
  status                 SubscriberStatus @default(pending)
  tokenHash              String?          @map("token_hash") // confirmation token: hash only
  tokenExpiresAt         DateTime?        @map("token_expires_at") @db.Timestamptz
  unsubscribeTokenHash   String?          @map("unsubscribe_token_hash") // permanent, created on confirmation
  confirmationSends      Int              @default(0) @map("confirmation_sends") @db.SmallInt
  lastConfirmationSentAt DateTime?        @map("last_confirmation_sent_at") @db.Timestamptz
  consentAt              DateTime?        @map("consent_at") @db.Timestamptz
  consentIp              String?          @map("consent_ip") @db.Inet
  consentUserAgent       String?          @map("consent_user_agent")
  policyVersion          String?          @map("policy_version")
  signedUpAt             DateTime         @default(now()) @map("signed_up_at") @db.Timestamptz
  confirmedAt            DateTime?        @map("confirmed_at") @db.Timestamptz
  cancelledAt            DateTime?        @map("cancelled_at") @db.Timestamptz
  softBounces            Int              @default(0) @map("soft_bounces") @db.SmallInt
  updatedAt              DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  deliveries Delivery[]

  @@index([status])
  @@index([tokenHash])
  @@index([unsubscribeTokenHash])
  @@index([tokenExpiresAt])
  @@index([cancelledAt])
  @@map("subscriber")
}

model Article {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  editionId      String?          @map("edition_id") @db.Uuid // null until selected
  canonicalUrl   String           @unique @map("canonical_url") // identity and link
  sourceId       String?          @map("source_id") @db.Uuid // null for articles from before ARG-123
  sourceName     String           @map("source_name")
  originalTitle  String           @map("original_title")
  extractedText  String?          @map("extracted_text") // feed or page text; cleared once sent
  textKind       TextKind?        @map("text_kind") // what the feed carried
  origin         FeedKind? // the kind of address that listed it
  publishedAt    DateTime?        @map("published_at") @db.Timestamptz
  codeScore      Int?             @map("code_score") // the ingestion's triage; signals in score_details
  groupMembers   Json             @default("[]") @map("group_members") // same fact elsewhere, by relevance
  titleSignature Int[]            @default([]) @map("title_signature") // MinHash; emptied after 3 days
  category       ArticleCategory?
  score          Decimal?         @db.Decimal(5, 2) // set on selection, frozen once sent
  scoreDetails   Json?            @map("score_details")
  headline       String?
  body           String? // 100 to 272 characters (check constraints)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  edition Edition? @relation(fields: [editionId], references: [id])
  source  Source?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([publishedAt(sort: Desc)])
  @@index([editionId, score(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  // Plus, in SQL only: a partial index on (created_at, score desc) where edition_id is null and
  // extracted_text is not null — what the writing step selects from — and partial unique indexes on
  // the two token hashes of `subscriber`. See migration 20260924120000_retention_indexes.
  @@map("article")
}

model Edition {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date      DateTime      @unique @db.Date
  status    EditionStatus @default(generating)
  title     String? // e-mail header
  subject   String? // e-mail subject, up to 78 characters (check constraint)
  html      String? // built once, read by the archive and resends
  text      String? // plain-text version
  sentAt    DateTime?     @map("sent_at") @db.Timestamptz
  reviewLog Json          @default("[]") @map("review_log") // [{attempt, step, verdict, analysis}]
  tokenCost Json          @default("{}") @map("token_cost") // {step: {model, input, output}}
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  articles   Article[]
  deliveries Delivery[]

  @@map("edition")
}

model Delivery {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  editionId       String         @map("edition_id") @db.Uuid
  subscriberId    String         @map("subscriber_id") @db.Uuid
  batch           Int // provider idempotency key: edition_id:batch
  status          DeliveryStatus @default(pending) // only moves forward
  providerEmailId String?        @map("provider_email_id")
  sentAt          DateTime?      @map("sent_at") @db.Timestamptz
  error           String?
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  edition    Edition    @relation(fields: [editionId], references: [id], onDelete: Cascade)
  subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([editionId, subscriberId])
  @@index([editionId, status])
  @@index([providerEmailId])
  @@map("delivery")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("setting")
}

// Every link an ingestion listed, stored or not, so a later run does not process it again: the
// sha256 of its canonical form, never the link. Deleted after 3 days by RetentionScheduler.
model SeenUrl {
  urlHash String   @id @map("url_hash") @db.Char(64)
  seenAt  DateTime @default(now()) @map("seen_at") @db.Timestamptz

  @@index([seenAt])
  @@map("seen_url")
}

// Where the news comes from. Each environment has its own rows; a source can be tried in dev
// before prod. The domain is the allowlist of `read_page` and of what an ingestion stores; the
// section rules are the per-source part of the triage (src/ingest/source.ts). Written only through
// the internal routes of SourcesController, which log the before and the after.
model Source {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  domain              String    @unique
  name                String
  covers              String
  trust               Int       @default(0) @db.SmallInt // 0 or 1: picks the group's representative, and a point
  active              Boolean   @default(true)
  sectionRules        Json      @default("[]") @map("section_rules")
  lastOkAt            DateTime? @map("last_ok_at") @db.Timestamptz
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  alertedAt           DateTime? @map("alerted_at") @db.Timestamptz // set when the owners heard of the failures
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  feeds    SourceFeed[]
  articles Article[]

  @@map("source")
}

model SourceFeed {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId  String   @map("source_id") @db.Uuid
  kind      FeedKind
  url       String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, url])
  @@map("source_feed")
}
