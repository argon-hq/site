{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "incremental": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": true,
    // Node10 resolution ignores the `exports` map, and @mastra/evals ships its API only on subpaths
    // (Node resolves them at runtime). These point the compiler at the same files.
    "baseUrl": ".",
    "paths": {
      "@mastra/evals/scorers/prebuilt": ["node_modules/@mastra/evals/dist/scorers/prebuilt/index.d.ts"],
      "@mastra/evals/scorers/utils": ["node_modules/@mastra/evals/dist/scorers/utils.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
