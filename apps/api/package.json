{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "generate": "prisma generate",
    "db:up": "docker compose -f compose.local.yml up -d --wait",
    "db:down": "docker compose -f compose.local.yml down",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:pull": "tsx scripts/db-pull.ts",
    "email:preview": "tsx src/email/preview.ts",
    "email:send": "tsx scripts/send-preview.ts",
    "email:icons": "tsx scripts/build-email-icons.ts",
    "ingest:sources": "tsx scripts/ingest.ts sources",
    "ingest:feed": "tsx scripts/ingest.ts feed",
    "ingest:page": "tsx scripts/ingest.ts page",
    "ingest:run": "tsx scripts/ingest.ts run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1164.0",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/client-ssm": "^3.1164.0",
    "@mastra/core": "^1.82.0",
    "@mastra/editor": "^0.17.0",
    "@mastra/nestjs": "^0.2.41",
    "@mastra/pg": "^1.35.0",
    "@mozilla/readability": "^0.6.0",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/schedule": "^12.0.3",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.2.0",
    "dotenv": "^18.0.9",
    "effect": "^3.22.4",
    "fast-xml-parser": "^5.12.0",
    "linkedom": "^0.18.15",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.37.0",
    "rxjs": "^7.8.2",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fortawesome/free-brands-svg-icons": "^7.1.0",
    "@mastra/evals": "^1.10.11",
    "@mastra/observability": "^1.23.1",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/testing": "^12.4.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.11.0",
    "mastra": "^1.38.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
