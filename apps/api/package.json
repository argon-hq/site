{
  "name": "@argon/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "db:up": "docker compose -f compose.local.yml up -d --wait",
    "db:down": "docker compose -f compose.local.yml down",
    "mastra:dev": "mastra dev --dir src/mastra",
    "prebuild": "prisma generate",
    "predev": "prisma generate",
    "pretest": "prisma generate",
    "precheck-types": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@mastra/core": "^1.67.0",
    "@mastra/nestjs": "^0.2.26",
    "@mastra/pg": "^1.25.0",
    "@mozilla/readability": "^0.6.0",
    "@nestjs/common": "^11.2.5",
    "@nestjs/core": "^11.2.5",
    "@nestjs/platform-express": "^11.2.5",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.4.2",
    "linkedom": "^0.18.13",
    "prisma": "7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.5",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "mastra": "^1.30.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
