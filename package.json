{
  "name": "argon",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "certs": "node scripts/dev-certs.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "format": "prettier --write \"apps/*/src/**/*.{ts,tsx,css}\" \"apps/*/*.{ts,mjs,mts,json}\" \"deploy/**/*.{yml,yaml}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"apps/*/src/**/*.{ts,tsx,css}\" \"apps/*/*.{ts,mjs,mts,json}\" \"deploy/**/*.{yml,yaml}\" \".github/**/*.yml\""
  },
  "devDependencies": {
    "prettier": "^3.9.8",
    "turbo": "^2.11.3"
  }
}
